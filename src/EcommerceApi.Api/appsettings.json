{
  "ConnectionStrings": {
    "Orders": "Data Source=data/ecommerce.db"
  },
  "Jwt": {
    "Issuer": "EcommerceApi",
    "Audience": "EcommerceApi.Client",
    "LifetimeMinutes": 60,
    "SigningKey": "local-development-key-with-at-least-32-bytes"
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*"
}
